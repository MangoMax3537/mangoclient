{
  "name": "mangoclient",
  "productName": "MangoClient",
  "desktopName": "mangoclient",
  "version": "1.2.12",
  "description": "A fast Minecraft launcher with Modrinth mods, Fabric/Forge support and one-click performance profiles.",
  "main": "src/main/index.js",
  "author": "mangomax",
  "license": "MIT",
  "repository": "https://github.com/MangoMax3537/mangoclient",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npm run build:mods && electron-builder",
    "build:mods": "node tools/build-mods.js",
    "dist": "npm run build",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.mangomax.mangoclient",
    "productName": "MangoClient",
    "directories": {
      "output": "dist",
      "buildResources": "src/assets"
    },
    "asarUnpack": [
      "src/main/assets/**",
      "src/assets/fontconfig.conf"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "src/assets/icons",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "src/assets/icon.png"
    },
    "publish": [
      {
        "provider": "github"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "allowScripts": {
    "electron@43.4.1": true
  }
}
